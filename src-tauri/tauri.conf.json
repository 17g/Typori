{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Typori",
  "version": "0.1.0",
  "identifier": "com.typori.editor",

  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Typori",
        "width": 1100,
        "height": 750,
        "minWidth": 650,
        "minHeight": 450,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "Copyright © 2026 Typori",
    "category": "Productivity",
    "shortDescription": "Typora-like minimalist local Markdown editor",
    "longDescription": "A high-performance, minimalist local Markdown editor built with Tauri, React, and Milkdown.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
